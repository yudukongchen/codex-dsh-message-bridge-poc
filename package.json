{
  "name": "codex-dsh-message-bridge-poc",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "./dsh-plugin.mjs",
  "exports": {
    ".": "./dsh-plugin.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dsh-plugin.mjs",
    "request-state.mjs",
    "transport.mjs",
    "cordis.patch.yml",
